NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_KEY=sb_service_role_xxx
VIEW_COUNT_WORKER_POLL_MS=2000
VIEW_COUNT_WORKER_BATCH_SIZE=25
NUXT_SUPABASE_SECRET_KEY=sb_secret_xxx

# LM Studio AI provider (local runtime, OpenAI-compatible API)
LMSTUDIO_BASE_URL=http://localhost:1234
LMSTUDIO_EMBEDDING_MODEL=embeddinggemma-300m-qat-GGUF
LMSTUDIO_CHAT_MODEL=your-chat-model-identifier
AI_DEBUG=false

# Embedding background worker
EMBEDDING_WORKER_POLL_MS=5000
EMBEDDING_WORKER_BATCH_SIZE=10

# Optional, for CLI type generation:
SUPABASE_PROJECT_REF=your-project-ref
